#!/usr/bin/env python3
"""
enforce-envelope

Gate ejecutable para validar que la salida de una skill/agente cumpla un
contrato mínimo auditable.

No verifica verdad semántica.
No reemplaza revisión humana.
No decide si la implementación es buena.
Solo valida forma, evidencia mínima y artefactos declarados.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path
from typing import Dict, List, Tuple


REQUIRED_FIELDS = [
    "Status",
    "Summary",
    "Artifacts",
    "Evidence",
    "Risks",
    "Next",
]

ALLOWED_STATUS = {"PASS", "FAIL", "BLOCKED"}

NONE_VALUES = {
    "",
    "none",
    "no",
    "n/a",
    "na",
    "null",
    "[]",
    "-",
}

FIELD_RE = re.compile(r"^([A-Za-z][A-Za-z0-9_-]*):\s*(.*)$")

# Bloquea OSC, ANSI/ESC, NULL y caracteres de control peligrosos.
# Permite \n, \r y \t.
DANGEROUS_CONTROL_RE = re.compile(
    r"(\x1b\]|\x1b\[|\x1bP|\x1b\\|\x00|[\x01-\x08\x0b\x0c\x0e-\x1f\x7f])"
)


def fail(message: str, json_output: bool = False, errors: List[str] | None = None) -> int:
    payload = {
        "ok": False,
        "message": message,
        "errors": errors or [message],
    }
    if json_output:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
    else:
        print(f"ENVELOPE FAIL: {message}", file=sys.stderr)
        for err in payload["errors"]:
            print(f"- {err}", file=sys.stderr)
    return 1


def ok(fields: Dict[str, str], json_output: bool = False) -> int:
    payload = {
        "ok": True,
        "status": fields["Status"],
        "fields": fields,
    }
    if json_output:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
    else:
        print(f"ENVELOPE PASS: {fields['Status']}")
    return 0


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        raise ValueError("output file is not valid UTF-8")
    except FileNotFoundError:
        raise ValueError(f"output file not found: {path}")


def check_terminal_garbage(text: str) -> List[str]:
    errors: List[str] = []
    match = DANGEROUS_CONTROL_RE.search(text)
    if match:
        codepoint = ord(match.group(0)[0])
        errors.append(
            f"dangerous terminal/control character detected: U+{codepoint:04X}"
        )
    return errors


def parse_fields(text: str) -> Tuple[Dict[str, str], List[str], List[str]]:
    fields_raw: Dict[str, List[str]] = {}
    field_order: List[str] = []
    errors: List[str] = []

    current_key: str | None = None
    seen_first_field = False

    for line_no, line in enumerate(text.splitlines(), start=1):
        match = FIELD_RE.match(line)

        if match:
            key = match.group(1).strip()
            value = match.group(2).rstrip()

            if key in fields_raw:
                errors.append(f"duplicate field '{key}' at line {line_no}")

            fields_raw.setdefault(key, []).append(value)
            field_order.append(key)
            current_key = key
            seen_first_field = True
            continue

        if not seen_first_field:
            if line.strip():
                errors.append(
                    f"text before first envelope field at line {line_no}; "
                    "output must start with the envelope"
                )
            continue

        if current_key is not None:
            fields_raw[current_key].append(line.rstrip())

    fields = {
        key: "\n".join(value_lines).strip()
        for key, value_lines in fields_raw.items()
    }

    return fields, field_order, errors


def is_emptyish(value: str) -> bool:
    return value.strip().lower() in NONE_VALUES


def parse_artifacts(raw: str) -> List[str]:
    """
    Acepta:
    Artifacts: []
    Artifacts: none
    Artifacts: [a.md, b.md]
    Artifacts: a.md, b.md
    Artifacts:
    - a.md
    - b.md

    No acepta descripciones mezcladas. Artifacts debe contener rutas.
    """
    if is_emptyish(raw):
        return []

    items: List[str] = []

    for line in raw.splitlines():
        line = line.strip()

        if not line:
            continue

        if line.lower() in NONE_VALUES:
            continue

        if line.startswith("- ") or line.startswith("* "):
            line = line[2:].strip()

        if line.startswith("[") and line.endswith("]"):
            line = line[1:-1].strip()

        if not line:
            continue

        for part in line.split(","):
            candidate = part.strip().strip("'\"")
            if candidate and candidate.lower() not in NONE_VALUES:
                items.append(candidate)

    return items


def validate_artifacts(artifact_items: List[str], root: Path) -> List[str]:
    errors: List[str] = []
    root = root.resolve()

    for item in artifact_items:
        if item.startswith("~"):
            errors.append(f"artifact must not use '~': {item}")
            continue

        path = Path(item)

        if path.is_absolute():
            errors.append(f"artifact must be relative, not absolute: {item}")
            continue

        resolved = (root / path).resolve()

        try:
            resolved.relative_to(root)
        except ValueError:
            errors.append(f"artifact escapes root with '..' or symlink: {item}")
            continue

        if not resolved.exists():
            errors.append(f"declared artifact does not exist: {item}")
            continue

    return errors


def validate_required_fields(fields: Dict[str, str], field_order: List[str]) -> List[str]:
    errors: List[str] = []

    for field in REQUIRED_FIELDS:
        if field not in fields:
            errors.append(f"missing required field: {field}")

    if field_order and field_order[0] != "Status":
        errors.append("first envelope field must be Status")

    if "Status" in fields:
        status = fields["Status"].strip().upper()
        if status not in ALLOWED_STATUS:
            errors.append(
                f"invalid Status '{fields['Status']}'; "
                f"allowed: {', '.join(sorted(ALLOWED_STATUS))}"
            )
        else:
            fields["Status"] = status

    for field in ["Summary", "Evidence", "Next"]:
        if field in fields and is_emptyish(fields[field]):
            errors.append(f"{field} must not be empty")

    if fields.get("Status") == "PASS":
        if "Evidence" in fields and is_emptyish(fields["Evidence"]):
            errors.append("PASS requires non-empty Evidence")

    return errors


def validate_unknown_fields(fields: Dict[str, str], strict: bool) -> List[str]:
    if not strict:
        return []

    allowed = set(REQUIRED_FIELDS)
    unknown = sorted(set(fields) - allowed)

    return [f"unknown field in strict mode: {field}" for field in unknown]


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Validate a skill output envelope."
    )
    parser.add_argument(
        "output_file",
        type=Path,
        help="File containing the agent/skill output.",
    )
    parser.add_argument(
        "--root",
        type=Path,
        default=Path.cwd(),
        help="Root directory used to validate relative artifact paths. Default: cwd.",
    )
    parser.add_argument(
        "--strict",
        action="store_true",
        help="Reject unknown envelope fields.",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Print machine-readable JSON result.",
    )

    args = parser.parse_args()

    errors: List[str] = []

    try:
        text = read_text(args.output_file)
    except ValueError as exc:
        return fail(str(exc), args.json)

    errors.extend(check_terminal_garbage(text))
    fields, field_order, parse_errors = parse_fields(text)
    errors.extend(parse_errors)

    errors.extend(validate_required_fields(fields, field_order))
    errors.extend(validate_unknown_fields(fields, args.strict))

    if "Artifacts" in fields:
        artifact_items = parse_artifacts(fields["Artifacts"])
        errors.extend(validate_artifacts(artifact_items, args.root))

    if errors:
        return fail("invalid skill output envelope", args.json, errors)

    return ok(fields, args.json)


if __name__ == "__main__":
    raise SystemExit(main())
